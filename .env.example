# Data storage directory (relative path, mounted into the container)
KAPPA_CORE_DIR=data

# P2P swarm topic prefix for node identification
SWARM_TOPIC_PREFIX=oscpdev_ssd

# Comma-separated ISO country codes this instance manages
COUNTRIES=IT,FI,US

# Service port
PORT=8031

# Local/dev: allow writes without Auth0 (provider becomes "noauthtest")
AUTH_REQUIRED=false

# Auth0 (required only when AUTH_REQUIRED=true)
AUTH0_ISSUER=https://<your_tenant>.auth0.com/
AUTH0_AUDIENCE=https://<your_domain>
